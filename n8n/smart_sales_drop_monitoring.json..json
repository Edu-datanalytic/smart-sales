{
  "name": "Smart Sales - Sales Drop Monitor",
  "nodes": [
    {
      "parameters": {
        "jsCode": "\nconst THRESHOLD_PERCENT = 20;\n\nconst rows = $input.all()\n  .map(item => ({\n    date: String(item.json.date),\n    sales: Number(item.json.sales)\n  }))\n  .filter(row => row.date && Number.isFinite(row.sales))\n  .sort((a, b) => a.date.localeCompare(b.date));\n\nif (rows.length < 2) {\n  throw new Error(`Solo se han recibido ${rows.length} filas válidas.`);\n}\n\nconst latest = rows[rows.length - 1];\nconst previous = rows.slice(0, -1);\n\nconst average = previous.reduce((sum, row) => sum + row.sales, 0) / previous.length;\n\nconst dropPercent = average > 0\n  ? Math.round(((average - latest.sales) / average) * 1000) / 10\n  : 0;\n\nreturn [{\n  json: {\n    rowsReceived: rows.length,\n    latestDate: latest.date,\n    latestSales: latest.sales,\n    averageSales: Math.round(average * 100) / 100,\n    dropPercent,\n    threshold: THRESHOLD_PERCENT,\n    isSignificantDrop: dropPercent >= THRESHOLD_PERCENT\n  }\n}];\n\n"
      },
      "id": "da56f066-c00b-4991-b76a-7e27bd5f3c68",
      "name": "Analyze Sales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
